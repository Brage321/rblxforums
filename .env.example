# Copy to .env. Never put API keys in public/.
PORT=3000
HOST=127.0.0.1
# Set to the public HTTPS origin behind your reverse proxy in production.
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
# Register this email to access the editor. Change before public deployment.
ADMIN_EMAIL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 0 disables scheduling. Values >= 1 generate a draft at this interval.
AI_UPDATE_HOURS=0
# Optional alternate SQLite location
# DB_PATH=./data/pathtodev.sqlite
